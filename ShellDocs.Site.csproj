<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UserSecretsId>shelldocs-site</UserSecretsId>
    <RootNamespace>ShellDocs.Site</RootNamespace>
    <AssemblyName>ShellDocs.Site</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ShellDocs.Components" Version="0.1.1-alpha" />
    <PackageReference Include="ShellDocs.Core"       Version="0.1.1-alpha" />
    <PackageReference Include="ShellDocs.Markdown"   Version="0.1.1-alpha" />
    <PackageReference Include="ShellDocs.Tokens"     Version="0.1.1-alpha" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="content/**/*.md;content/**/meta.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
