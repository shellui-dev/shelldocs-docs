@page "/"
@layout HomeLayout
@inject ShellDocsOptions Options

<PageTitle>ShellDocs : the docs framework for .NET</PageTitle>

<div class="site-home">
    <section class="hero">
        <h1>The docs framework <span class="grad">for .NET.</span></h1>
        <p class="hero-sub">
            Beautiful, animated, Cmd+K-searchable documentation sites : powered by Blazor,
            composable with ShellUI (or any component library), and shaped like fumadocs meets shadcn.
        </p>
        <div class="hero-ctas">
            <a href="/docs/introduction" class="btn primary">
                Get started
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/docs/components/callout" class="btn secondary">
                Browse components
            </a>
        </div>
        <div class="hero-install">
            <span>$</span>
            <code>dotnet tool install -g ShellDocs.CLI <span class="flag">--prerelease</span></code>
            <button type="button" class="hero-copy" data-copy="dotnet tool install -g ShellDocs.CLI --prerelease" aria-label="Copy the install command">
                <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
        </div>
    </section>

    <FeatureBento />

    <section class="cta-strip">
        <div>
            <h2>Install and ship in five minutes.</h2>
            <p>The alpha is on NuGet. Getting Started walks you through the whole flow.</p>
        </div>
        <a href="/docs/getting-started/installation" class="btn primary">
            Installation
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
    </section>
</div>

<SiteFooter />

<style>
    .site-home {
        max-width: 68rem;
        margin: 0 auto;
        padding: 4rem 1.5rem 5rem;
    }

    .hero { text-align: center; }
    /* The hero settles in on load, one line after the other. */
    .hero > * { animation: hero-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .hero > :nth-child(2) { animation-delay: 80ms; }
    .hero > :nth-child(3) { animation-delay: 160ms; }
    .hero > :nth-child(4) { animation-delay: 240ms; }
    @@keyframes hero-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) { .hero > * { animation: none; } }

    .hero h1 {
        font-size: clamp(2.5rem, 5vw, 3.75rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.05;
        margin: 0 0 1.25rem;
    }
    .hero h1 .grad {
        background: linear-gradient(135deg, var(--foreground), color-mix(in oklch, var(--foreground) 55%, transparent));
        -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .hero-sub {
        color: var(--muted-foreground);
        font-size: 1.125rem;
        line-height: 1.55;
        max-width: 40rem;
        margin: 0 auto 2rem;
    }
    .hero-ctas { display: inline-flex; gap: 0.65rem; }
    .hero-install {
        display: flex; width: fit-content; max-width: 100%; margin: 1.5rem auto 0;
        align-items: center; gap: 0.6rem; padding: 0.3rem 0.35rem 0.3rem 1rem;
        border: 1px solid var(--border); border-radius: 9999px; background: var(--card);
        font-family: var(--font-mono); font-size: 0.82rem;
    }
    .hero-install > span { color: var(--muted-foreground); }
    .hero-install .flag { white-space: nowrap; }
    .hero-copy {
        display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
        width: 1.9rem; height: 1.9rem; border: 0; border-radius: 9999px;
        background: transparent; color: var(--muted-foreground); cursor: pointer;
        transition: background 150ms, color 150ms;
    }
    .hero-copy:hover { background: var(--muted); color: var(--foreground); }
    .hero-copy svg { width: 0.9rem; height: 0.9rem; }
    .hero-copy .icon-check { display: none; color: var(--success, oklch(0.72 0.17 150)); }
    .hero-copy.copied .icon-copy { display: none; }
    .hero-copy.copied .icon-check { display: block; }
    .hero-install code { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    @@media (max-width: 480px) {
        .hero-install { border-radius: calc(var(--radius) + 2px); text-align: left; }
        .hero-install code { white-space: normal; }
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1.15rem;
        border-radius: calc(var(--radius) + 2px);
        font-weight: 500;
        font-size: 0.9rem;
        text-decoration: none;
        transition: background 150ms, border-color 150ms, transform 150ms;
    }
    .btn.primary { background: var(--primary); color: var(--primary-foreground); }
    .btn.primary:hover { background: color-mix(in oklch, var(--primary) 90%, transparent); }
    .btn.secondary { background: var(--card); color: var(--foreground); border: 1px solid var(--border); }
    .btn.secondary:hover { background: var(--muted); border-color: color-mix(in oklch, var(--border) 60%, var(--foreground)); }
    .btn svg { width: 0.85rem; height: 0.85rem; }

    .cta-strip {
        margin-top: 4.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        align-items: flex-start;
        padding: 2rem 2rem;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) + 6px);
        background: color-mix(in oklch, var(--card) 55%, var(--background));
    }
    @@media (min-width: 640px) { .cta-strip { flex-direction: row; align-items: center; justify-content: space-between; } }
    .cta-strip h2 { margin: 0 0 0.35rem; font-size: 1.25rem; font-weight: 600; letter-spacing: -0.015em; }
    .cta-strip p { margin: 0; color: var(--muted-foreground); font-size: 0.9rem; }
</style>
